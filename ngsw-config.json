{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/main*.js", "/polyfills*.js"]
      }
    },
    {
      "name": "pantallas",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/chunk-*.js"]
      }
    },
    {
      "name": "imagenes",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/icons/**", "/*.png", "/img_logos/**", "/img_home/**", "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/uploads/**",
    "!/.well-known/**"
  ]
}
